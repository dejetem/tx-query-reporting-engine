{
  "name": "tx-query-reporting-engine",
  "version": "1.0.0",
  "description": "High-Throughput Transaction Query & Async Reporting Engine with Fastify, Partitioned PostgreSQL, Redis, BullMQ, OpenTelemetry & Prometheus",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx watch src/server.ts",
    "worker": "node dist/workers/export.worker.js",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "bullmq": "^5.15.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
